# Copy to .env and adjust. .env is gitignored; never commit real credentials.

# PostgreSQL (used by docker-compose.yml)
POSTGRES_USER=skywire
POSTGRES_PASSWORD=skywire
POSTGRES_DB=skywire
POSTGRES_PORT=5432

# Used by backend code run on the host (tests, scripts, alembic).
# Containers get their own value from docker-compose.yml, pointing at the db service.
DATABASE_URL=postgresql+psycopg://skywire:skywire@localhost:5432/skywire

# OpenSky API client (OAuth2 client credentials). Create one on your OpenSky
# account page; the downloaded credentials.json holds clientId and clientSecret.
# Leave both empty for anonymous access (400 credits/day instead of 4000).
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Area to monitor, decimal degrees. Default is Florida (about 54 square degrees,
# which costs 2 API credits per request).
BBOX_LAMIN=24.3
BBOX_LAMAX=31.1
BBOX_LOMIN=-87.7
BBOX_LOMAX=-79.8
